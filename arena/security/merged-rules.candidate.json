{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth.token.email === 'hazemshaaban65@gmail.com'",
        "players": {
          "$uid": {
            "name": {
              ".write": "auth != null && auth.uid === $uid && !root.child('rooms').child($room).child('ctl').child('lock').exists() && !root.child('rooms').child($room).child('kicked').child(auth.uid).exists()",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            }
          }
        }
      }
    },
    "ans": {
      "$room": {
        ".read": "auth.token.email === 'hazemshaaban65@gmail.com'",
        ".write": "auth.token.email === 'hazemshaaban65@gmail.com'",
        "$q": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.hasChildren(['k','ts']) && newData.child('k').isNumber() && newData.child('ts').val() === now"
          }
        }
      }
    },
    "eids": {
      "$room": {
        ".read": "auth.token.email === 'hazemshaaban65@gmail.com'",
        ".write": "auth.token.email === 'hazemshaaban65@gmail.com'",
        "$eid": {
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
          ".validate": "newData.isString() && newData.val() === auth.uid && $eid.length <= 20"
        }
      }
    },
    "arenaV1": {
      ".read": false,
      ".write": false,
      "trainerAllowlist": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('arenaV1/trainerAllowlist').child(auth.uid).val() === true)",
          ".write": false
        }
      },
      "rooms": {
        "$roomId": {
          ".read": false,
          ".write": false,
          "public": {
            ".read": "auth != null",
            ".write": "auth != null && root.child('arenaV1/trainerAllowlist').child(auth.uid).val() === true && newData.exists() && (!data.exists() || data.child('status').val() !== 'completed')",
            ".validate": "newData.hasChildren(['title', 'status', 'round', 'question', 'options', 'deadline', 'joinOpen']) && (!data.exists() ||  (data.child('status').val() === 'lobby' && (newData.child('status').val() === 'lobby' || newData.child('status').val() === 'question' || newData.child('status').val() === 'completed')) ||  (data.child('status').val() === 'question' && (newData.child('status').val() === 'between' || newData.child('status').val() === 'completed')) ||  (data.child('status').val() === 'between' && (newData.child('status').val() === 'question' || newData.child('status').val() === 'completed'))) && (newData.child('status').val() !== 'completed' || newData.child('joinOpen').val() === false) && (!data.exists() || data.child('status').val() !== 'question' || (newData.child('round').val() === data.child('round').val() && newData.child('question').val() === data.child('question').val() && newData.child('deadline').val() === data.child('deadline').val() && newData.child('options/0').val() === data.child('options/0').val() && newData.child('options/1').val() === data.child('options/1').val() && newData.child('options/2').val() === data.child('options/2').val() && newData.child('options/3').val() === data.child('options/3').val() && newData.child('options/4').val() === data.child('options/4').val() && newData.child('options/5').val() === data.child('options/5').val() && newData.child('options/6').val() === data.child('options/6').val() && newData.child('options/7').val() === data.child('options/7').val())) && (!data.exists() || data.child('status').val() !== 'between' || newData.child('status').val() !== 'question' || newData.child('round').val() !== data.child('round').val())",
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "status": {
              ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'question' || newData.val() === 'between' || newData.val() === 'completed')"
            },
            "round": {
              ".validate": "newData.isString() && newData.val().matches(/^r[0-9]+$/)"
            },
            "question": {
              ".validate": "newData.isString() && newData.val().length <= 1000"
            },
            "options": {
              ".validate": "newData.hasChildren(['0', '1'])"
            },
            "deadline": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "joinOpen": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "private": {
            ".read": "auth != null && root.child('arenaV1/trainerAllowlist').child(auth.uid).val() === true",
            ".write": "auth != null && root.child('arenaV1/trainerAllowlist').child(auth.uid).val() === true"
          }
        }
      },
      "claims": {
        "$roomId": {
          "$employeeId": {
            ".read": "auth != null && (!data.exists() || data.val() === auth.uid || root.child('arenaV1/trainerAllowlist').child(auth.uid).val() === true)",
            ".write": "auth != null && !data.exists() && newData.isString() && newData.val() === auth.uid && $employeeId.matches(/^[A-Z0-9_-]{2,20}$/) && root.child('arenaV1/rooms').child($roomId).child('public/joinOpen').val() === true",
            ".validate": "newData.isString()"
          }
        }
      },
      "participants": {
        "$roomId": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('arenaV1/trainerAllowlist').child(auth.uid).val() === true)",
            ".write": "auth != null && (root.child('arenaV1/trainerAllowlist').child(auth.uid).val() === true || (auth.uid === $uid && !data.exists() && root.child('arenaV1/rooms').child($roomId).child('public/joinOpen').val() === true && root.child('arenaV1/claims').child($roomId).child(newData.child('employeeId').val()).val() === auth.uid && newData.child('joinedRound').val() === root.child('arenaV1/rooms').child($roomId).child('public/round').val()))",
            ".validate": "newData.hasChildren(['name', 'employeeId', 'joinedRound'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"
            },
            "employeeId": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9_-]{2,20}$/)"
            },
            "joinedRound": {
              ".validate": "newData.isString() && newData.val().matches(/^r[0-9]+$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "answers": {
        "$roomId": {
          "$round": {
            ".read": "auth != null && root.child('arenaV1/trainerAllowlist').child(auth.uid).val() === true",
            "$uid": {
              ".read": "auth != null && (auth.uid === $uid || root.child('arenaV1/trainerAllowlist').child(auth.uid).val() === true)",
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('arenaV1/participants').child($roomId).child(auth.uid).exists() && root.child('arenaV1/rooms').child($roomId).child('public/status').val() === 'question' && root.child('arenaV1/rooms').child($roomId).child('public/round').val() === $round && root.child('arenaV1/participants').child($roomId).child(auth.uid).child('joinedRound').val() !== $round && now <= root.child('arenaV1/rooms').child($roomId).child('public/deadline').val()",
              ".validate": "newData.hasChildren(['choice'])",
              "choice": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 8 && root.child('arenaV1/rooms').child($roomId).child('public/options').child(newData.val() + '').exists()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}
